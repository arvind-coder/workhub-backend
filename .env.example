# Copy to .env for local development. Never commit .env.
# Every value below is a placeholder, not a real credential.

# development | production | test.
# The /api/projects/test-* debug routes exist ONLY when this is "development".
NODE_ENV=development
PORT=5000

# Local MongoDB. In production use a dedicated database user.
MONGODB_URI=mongodb://127.0.0.1:27017/workhub

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated exact browser origins (scheme + host [+ port]); no wildcard,
# path or trailing slash. Requests without an Origin header (curl, servers)
# are always allowed. Empty = no browser origin is accepted.
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the app (0 = none). Needed so rate
# limiting sees the real client IP, e.g. 1 behind a single load balancer.
TRUST_PROXY=0

# Max requests per 15 minutes per IP.
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300

# Swagger UI at /api/docs. Defaults to true outside production, false in
# production. Set explicitly to override.
# ENABLE_API_DOCS=true

# Optional, tests only: a MongoDB server the test suite may create
# throw-away "workhub_test_*" databases on. If unset, tests start their own
# temporary mongod (needs `mongod` on PATH). Never point this at a database
# you care about unless the server is dedicated to testing.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
