NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/workhub

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the app (0 = none).
TRUST_PROXY=0

# Max requests per 15 minutes per IP.
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
